      "lesson": [
        {
          "title": "Count on from the bigger number",
          "body": "For 2 + 7, start at 7 and count on 2: 8, 9. Starting from the bigger number means fewer steps."
        },
        {
          "title": "Worked example",
          "example": {"template": "add-subtract.small", "params": {"x": 2, "y": 7}, "format": "xy"}
        },
        {
          "title": "Take away by adding",
          "body": "9 − 2 asks what goes with 2 to make 9. It is 7, because 2 + 7 = 9."
        }
      ]
    },
    {
      "id": "make-10",
      "title": "Make 10",
      "kind": "facts",
      "templates": ["add-subtract.make-10", "add-subtract.to-10", "add-subtract.from-10"],
      "lesson": [
        {
          "title": "Pairs that make 10",
          "body": "1 and 9, 2 and 8, 3 and 7, 4 and 6, 5 and 5. Knowing these pairs makes adding and taking away across 10 quick."
        },
        {
          "title": "Worked example",
          "example": {"template": "add-subtract.to-10", "params": {"x": 7}, "format": "missing"}
        },
        {"title": "10 take away", "body": "10 − 4 is the number that goes with 4 to make 10: 6."}
      ]
    },
    {
      "id": "doubles",
      "title": "Doubles and near doubles",
      "kind": "facts",
      "templates": ["add-subtract.doubles", "add-subtract.near-doubles", "add-subtract.halves", "add-subtract.near-halves"],
      "lesson": [
        {
          "title": "Doubles",
          "body": "6 + 6 = 12, 7 + 7 = 14, 8 + 8 = 16. A double is a number added to itself."
        },
        {
          "title": "Worked example",
          "example": {"template": "add-subtract.near-doubles", "params": {"x": 7, "y": 8}, "format": "xy"}
        },
        {"title": "Halves", "body": "14 − 7 = 7: take half of a double away and the other half is left."}
      ]
    },
    {
      "id": "adding-10",
      "title": "Adding 10",
      "kind": "facts",
      "templates": ["add-subtract.ten", "add-subtract.take-ten"],
      "lesson": [
        {
          "title": "A ten and some ones",
          "body": "10 + 6 is one ten and six ones: 16. Take the 10 away again and the 6 is left."
        },
        {
          "title": "Worked example",
          "example": {"template": "add-subtract.take-ten", "params": {"x": 6}, "format": "take"}
        }
      ]
    },
    {
      "id": "bridge-10",
      "title": "Bridge through 10",
      "kind": "facts",
      "templates": ["add-subtract.bridge", "add-subtract.take-bridge"],
      "lesson": [
        {
          "title": "Make 10 first",
          "body": "8 + 5: 8 needs 2 to make 10, and 5 is 2 and 3. So 8 + 5 = 10 + 3 = 13."
        },
        {
          "title": "Worked example",
          "example": {"template": "add-subtract.bridge", "params": {"x": 4, "y": 9}, "format": "xy"}
        },
        {"title": "Back through 10", "body": "13 − 5: take 3 to get back to 10, then 2 more. 10 − 2 = 8."}
      ]
    },
