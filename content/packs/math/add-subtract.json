      "grid": true,
      "params": {"x": {"range": [1, 4]}, "y": {"range": ["x + 2", "9 - x"]}},
      "answer": {"type": "integer", "value": "x + y"},
      "formats": [{"id": "xy", "prompt": "{x} + {y} = ?"}, {"id": "yx", "prompt": "{y} + {x} = ?"}],
      "hints": [
        "Start from the bigger number and count on.",
        "Start at {y} and count on {x}.",
        "{y}, then {x} more: ?"
      ],
      "steps": ["Start at the bigger number, {y}", "Count on {x}", "{y} + {x} = {answer}"],
      "explain": "Start at {y} and count on {x}: {answer}.",
      "distractors": [
        {
          "value": "x + y - 1",
          "error": "one-short",
          "feedback": "{value} is one short. Count on {x} from {y} again."
        },
        {
          "value": "x + y + 1",
          "error": "one-too-many",
          "feedback": "{value} is one too many. Count on {x} from {y} again."
        },
        {
          "value": "y > x ? y - x : -1",
          "error": "took-away-instead",
          "feedback": "{value} is {y} − {x}. + means put the two together."
