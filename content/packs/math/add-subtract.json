      "lesson": [
        {
          "title": "Tens, then ones",
          "body": "To add 47 + 28 in your head, add the tens first: 47 + 20 = 67. Then the ones: 67 + 8 = 75."
        },
        {
          "title": "Worked example",
          "example": {"template": "add-subtract.add-two-digit", "params": {"a": 47, "b": 28}, "format": "sum"}
        },
        {
          "title": "Round and adjust",
          "body": "Adding 29 is adding 30 and taking 1 back: 56 + 29 = 86 − 1 = 85."
        }
      ]
