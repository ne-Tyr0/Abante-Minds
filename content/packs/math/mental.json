      "domain": "NA",
      "construct": "Multiply by halving one number and doubling the other",
      "schema": "equal-groups",
      "params": {
        "b": {"choose": [5, 15, 25, 35, 45, 50]},
        "h": {"tiers": {"1": [2, 9], "3": [2, 24]}},
