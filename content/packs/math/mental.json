        "{a} × {b} = {h} × {2 * b}.",
        "{h} × {2 * b} = ?"
      ],
      "steps": ["Halve {a}: {h}", "Double {b}: {2 * b}", "{h} × {2 * b} = {answer}"],
      "explain": "{a} × {b} = {h} × {2 * b} = {answer}.",
      "distractors": [
        {
          "value": "h * b",
