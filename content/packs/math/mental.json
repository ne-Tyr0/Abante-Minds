{
  "topic": "mental",
  "levels": [
    {
      "id": "tens",
      "title": "Times and divide by 10, 100, 1000",
      "templates": ["mental.times-tens", "mental.divide-tens", "mental.tens-times"],
      "lesson": [
        {
          "title": "Move the digits",
          "body": "Times 10 moves every digit one place to the left: 37 × 10 = 370. Times 100 moves them two places: 37 × 100 = 3700."
        },
        {
          "title": "Worked example",
          "example": {"template": "mental.times-tens", "params": {"a": 37, "k": 2}, "format": "product"}
        },
        {
          "title": "Divide moves them back",
          "body": "4500 ÷ 100 = 45: every digit moves two places to the right. And 30 × 40 is 3 × 4 = 12 with two zeros: 1200."
        }
      ]
    },
    {
      "id": "double-halve",
      "title": "Double and halve",
      "templates": ["mental.double", "mental.halve", "mental.halve-double"],
      "lesson": [
        {"title": "Double the parts", "body": "Double 38: double 30 is 60, double 8 is 16, and 60 + 16 = 76."},
        {
          "title": "Worked example",
          "example": {"template": "mental.halve", "params": {"a": 37}, "format": "half"}
        },
        {
          "title": "Halve one, double the other",
          "body": "16 × 25 = 8 × 50 = 4 × 100 = 400. Halving one number and doubling the other keeps the answer the same."
        }
      ]
    },
    {
      "id": "five-nine-eleven",
      "title": "Times 5, 9 and 11",
      "templates": ["mental.times-5", "mental.times-9", "mental.times-11"],
      "lesson": [
        {"title": "Times 5", "body": "46 × 5 is half of 46 × 10: half of 460 is 230."},
        {
          "title": "Worked example",
          "example": {"template": "mental.times-9", "params": {"a": 34}, "format": "product"}
        },
        {"title": "Times 11", "body": "43 × 11 is 43 × 10 and one more 43: 430 + 43 = 473."}
      ]
    },
    {
      "id": "split",
      "title": "Split and multiply",
      "templates": ["mental.split-times", "mental.split-two-digit"],
      "lesson": [
        {
          "title": "Split the number",
          "body": "23 × 4 = 20 × 4 + 3 × 4 = 80 + 12 = 92. Multiply both parts, then add."
        },
        {
          "title": "Worked example",
          "example": {"template": "mental.split-times", "params": {"a": 23, "m": 4}, "format": "product"}
        },
        {"title": "Split the bigger number", "body": "23 × 14 = 23 × 10 + 23 × 4 = 230 + 92 = 322."}
      ]
    },
    {
      "id": "divide",
      "title": "Divide in your head",
      "templates": ["mental.split-divide", "mental.divide-by-5"],
      "lesson": [
        {
          "title": "Split, then divide",
          "body": "84 ÷ 4: 84 is 80 + 4, so the answer is 80 ÷ 4 + 4 ÷ 4 = 20 + 1 = 21."
        },
        {
          "title": "Worked example",
          "example": {"template": "mental.split-divide", "params": {"d": 8, "q": 12}, "format": "quotient"}
        },
        {"title": "Dividing by 5", "body": "85 ÷ 5 = 170 ÷ 10 = 17: double the number, then divide by 10."}
      ]
    },
    {
      "id": "estimate",
      "title": "Estimate",
      "templates": ["mental.estimate-product", "mental.estimate-sum"],
      "lesson": [
        {
          "title": "Round first",
          "body": "To estimate 49 × 21, round to 50 × 20 = 1000. The exact answer, 1029, is close."
        },
        {
          "title": "Worked example",
          "example": {"template": "mental.estimate-sum", "params": {"a": 398, "b": 211}, "format": "about"}
        },
        {
          "title": "Check with an estimate",
          "body": "An estimate tells you if an answer is about right: 31 × 19 cannot be 5890, because 30 × 20 is only 600."
        }
      ]
    }
  ],
  "templates": [
    {
      "id": "mental.times-tens",
      "domain": "NA",
      "construct": "Multiply a whole number by 10, 100 or 1000",
      "schema": "equal-groups",
      "params": {
        "a": {"tiers": {"1": [2, 99], "3": [11, 999]}},
        "k": {"tiers": {"1": [1, 2], "3": [1, 3]}},
        "p": {"value": "k == 1 ? 10 : (k == 2 ? 100 : 1000)"}
      },
      "where": ["a % 10 != 0"],
      "answer": {"type": "integer", "value": "a * p"},
      "formats": [{"id": "product", "prompt": "{a} × {p} = ?"}, {"id": "turned", "prompt": "{p} × {a} = ?"}],
      "hints": [
        "Times {p} moves every digit {k} place{k == 1 ? '' : 's'} to the left.",
        "That puts {k} zero{k == 1 ? '' : 's'} on the end of {a}.",
        "{a} with {k} zero{k == 1 ? '' : 's'} after it = ?"
      ],
      "steps": [
        "{p} has {k} zero{k == 1 ? '' : 's'}",
        "Each digit of {a} moves {k} place{k == 1 ? '' : 's'} left",
        "{a} × {p} = {answer}"
      ],
      "explain": "{a} × {p} = {answer}: {k} zero{k == 1 ? '' : 's'} on the end.",
      "distractors": [
        {
          "value": "a * p / 10",
          "error": "one-zero-short",
          "feedback": "{value} has one zero too few. {p} has {k} zero{k == 1 ? '' : 's'}."
        },
        {
          "value": "a * p * 10",
          "error": "one-zero-too-many",
          "feedback": "{value} has one zero too many. {p} has {k} zero{k == 1 ? '' : 's'}."
        },
        {
          "value": "a + p",
          "error": "added-instead",
          "feedback": "{value} is {a} + {p}. × means {p} lots of {a}."
        }
      ]
    },
    {
      "id": "mental.divide-tens",
      "domain": "NA",
      "construct": "Divide a whole number by 10, 100 or 1000 when the answer is whole",
      "schema": "equal-groups",
      "params": {
        "a": {"tiers": {"1": [2, 99], "3": [11, 999]}},
        "k": {"tiers": {"1": [1, 2], "3": [1, 3]}},
        "p": {"value": "k == 1 ? 10 : (k == 2 ? 100 : 1000)"},
        "n": {"value": "a * p"}
      },
      "where": ["a % 10 != 0"],
      "answer": {"type": "integer", "value": "a"},
      "formats": [
        {"id": "quotient", "prompt": "{n} ÷ {p} = ?"},
        {"id": "groups", "prompt": "How many groups of {p} make {n}?"}
      ],
      "hints": [
        "Divide by {p} moves every digit {k} place{k == 1 ? '' : 's'} to the right.",
        "That takes {k} zero{k == 1 ? '' : 's'} off the end of {n}.",
        "{n} without its last {k} zero{k == 1 ? '' : 's'} = ?"
      ],
      "steps": [
        "{p} has {k} zero{k == 1 ? '' : 's'}",
        "Each digit of {n} moves {k} place{k == 1 ? '' : 's'} right",
        "{n} ÷ {p} = {answer}"
      ],
      "explain": "{n} ÷ {p} = {answer}: {k} zero{k == 1 ? '' : 's'} off the end.",
      "distractors": [
        {
          "value": "a * 10",
          "error": "one-zero-too-many",
          "feedback": "{value} still has one zero too many. Take {k} zero{k == 1 ? '' : 's'} off {n}."
        },
        {
          "value": "a / 10",
          "error": "one-zero-too-few",
          "feedback": "{fmt(value)} takes off one place too many. Take off only {k} zero{k == 1 ? '' : 's'}."
        },
        {
          "value": "n - p",
          "error": "took-away-instead",
          "feedback": "{value} is {n} − {p}. ÷ asks how many {p}s make {n}."
        }
      ]
    },
    {
      "id": "mental.tens-times",
      "domain": "NA",
      "construct": "Multiply multiples of 10 and 100: the digits, then the zeros",
      "schema": "equal-groups",
      "params": {
        "x": {"range": [2, 9]},
        "y": {"range": [2, 9]},
        "i": {"tiers": {"1": [1, 1], "3": [1, 2]}},
        "j": {"tiers": {"1": [0, 1], "3": [1, 2]}},
        "a": {"value": "x * (i == 1 ? 10 : 100)"},
        "b": {"value": "y * (j == 0 ? 1 : (j == 1 ? 10 : 100))"},
        "z": {"value": "i + j"}
      },
      "answer": {"type": "integer", "value": "a * b"},
      "formats": [
        {"id": "product", "prompt": "{a} × {b} = ?"},
        {"id": "boxes", "prompt": "A shop packs {b} boxes with {a} pencils each. How many pencils is that?"}
      ],
      "hints": [
        "Multiply the digits that are not zeros, then put all the zeros back.",
        "{x} × {y} = {x * y}.",
        "{x * y} with {z} more zero{z == 1 ? '' : 's'} after it = ?"
      ],
      "steps": [
        "{x} × {y} = {x * y}",
        "{a} and {b} have {z} zero{z == 1 ? '' : 's'} between them",
        "{x * y} and {z} zero{z == 1 ? '' : 's'}: {answer}"
      ],
      "explain": "{x} × {y} = {x * y}, and {z} zero{z == 1 ? '' : 's'} makes {answer}.",
      "distractors": [
        {
          "value": "a * b / 10",
          "error": "a-zero-short",
          "feedback": "{value} has a zero too few. Count the zeros in both numbers: {z}."
        },
        {
          "value": "a * b * 10",
          "error": "a-zero-too-many",
          "feedback": "{value} has a zero too many. Count the zeros in both numbers: {z}."
        },
        {
          "value": "a + b",
          "error": "added-instead",
          "feedback": "{value} is {a} + {b}. × means {b} lots of {a}."
        }
      ]
    },
    {
      "id": "mental.double",
      "domain": "NA",
      "construct": "Double a two- or three-digit number in parts",
      "schema": "equal-groups",
      "params": {"a": {"tiers": {"1": [11, 49], "3": [51, 499]}}},
      "where": ["a % 10 != 0"],
      "answer": {"type": "integer", "value": "2 * a"},
      "formats": [
        {"id": "double", "prompt": "Double {a} = ?"},
        {"id": "times-2", "prompt": "{a} × 2 = ?"},
        {"id": "twice", "prompt": "{a} + {a} = ?"}
      ],
      "hints": [
        "Double the tens and the ones separately, then add.",
        "Double {a - a % 10} is {2 * (a - a % 10)}, and double {a % 10} is {2 * (a % 10)}.",
        "{2 * (a - a % 10)} + {2 * (a % 10)} = ?"
      ],
      "steps": [
        "Double {a - a % 10} = {2 * (a - a % 10)}",
        "Double {a % 10} = {2 * (a % 10)}",
        "{2 * (a - a % 10)} + {2 * (a % 10)} = {answer}"
      ],
      "explain": "Double {a - a % 10} and double {a % 10}: {2 * (a - a % 10)} + {2 * (a % 10)} = {answer}.",
      "distractors": [
        {
          "value": "2 * (a - a % 10) + a % 10",
          "error": "doubled-only-the-tens",
          "feedback": "{value} doubles {a - a % 10} but not the {a % 10}. Double both parts."
        },
        {"value": "a + 2", "error": "added-2", "feedback": "{value} adds 2. Double means 2 lots of {a}."}
      ]
    },
    {
      "id": "mental.halve",
      "domain": "NA",
      "construct": "Halve an even number in parts that are easy to halve",
      "schema": "equal-groups",
      "params": {"a": {"tiers": {"1": [11, 49], "3": [26, 499]}}, "n": {"value": "2 * a"}, "r": {"value": "n % 20"}},
      "where": ["r != 0"],
      "answer": {"type": "integer", "value": "a"},
      "formats": [
        {"id": "half", "prompt": "Half of {n} = ?"},
        {"id": "divide", "prompt": "{n} ÷ 2 = ?"},
        {"id": "share", "prompt": "₱{n} is shared equally between 2 children. How much does each get?"}
      ],
      "hints": [
        "Split {n} into parts that are easy to halve.",
        "{n} = {n - r} + {r}.",
        "Half of {n - r} is {(n - r) / 2}, and half of {r} is {r / 2}. Add them."
      ],
      "steps": [
        "{n} = {n - r} + {r}",
        "Half of {n - r} = {(n - r) / 2}; half of {r} = {r / 2}",
        "{(n - r) / 2} + {r / 2} = {answer}"
      ],
      "explain": "Half of {n - r} is {(n - r) / 2} and half of {r} is {r / 2}: {answer}.",
      "distractors": [
        {
          "value": "floor(n / 10) % 2 == 1 ? floor(n / 20) * 10 + n % 10 / 2 : -1",
          "error": "dropped-the-odd-ten",
          "feedback": "{value} halves {floor(n / 10)} tens to {floor(n / 20)} ten{floor(n / 20) == 1 ? '' : 's'} and drops the ten left over. Half of that ten is 5 more."
        },
        {
          "value": "2 * n",
          "error": "doubled-instead",
          "feedback": "{value} is double {n}. Half means 2 equal parts."
        }
      ]
    },
    {
