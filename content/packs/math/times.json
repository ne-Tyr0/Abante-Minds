      "answer": {"type": "integer", "value": "q"},
      "formats": [
        {"id": "divide", "prompt": "{n} ÷ {x} = ?"},
        {
          "id": "missing",
          "prompt": "? × {x} = {n}",
          "explain": "{answer} × {x} = {n}, so the missing number is {answer}."
        },
        {
          "id": "how-many",
          "prompt": "How many {x}s make {n}?",
          "explain": "{answer} groups of {x} make {n}: {answer} × {x} = {n}."
        }
      ],
      "hints": [
        "Divide undoes times: what times {x} makes {n}?",
        "Count up in {x}s and stop at {n}.",
        "{x} × {q > 1 ? q - 1 : 2} = {x * (q > 1 ? q - 1 : 2)}. {q > 1 ? 'One more ' : 'One fewer '}{fmt(x)} makes {n}."
      ],
      "steps": ["{n} ÷ {x} asks how many {x}s make {n}", "{x} × {q} = {n}", "So {n} ÷ {x} = {answer}"],
      "explain": "{x} × {q} = {n}, so {n} ÷ {x} = {answer}.",
      "distractors": [
        {
          "value": "q + 1",
          "error": "one-too-many",
          "feedback": "{value} × {x} = {value * x}, which is more than {n}."
        },
        {
          "value": "q > 1 ? q - 1 : -1",
          "error": "one-too-few",
          "feedback": "{value} × {x} = {value * x}, which is less than {n}."
        },
        {
          "value": "n - x",
          "error": "took-away-instead",
          "feedback": "{value} is {n} − {x}. Divide asks how many {x}s make {n}."
        }
      ]
    },
