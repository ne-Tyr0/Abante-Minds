{
  "topic": "times",
  "grid": {"title": "Times table", "sign": "×", "from": 2, "to": 12},
  "levels": [
    {
      "id": "2-5-10",
      "title": "2, 5 and 10",
      "kind": "facts",
      "templates": ["times.x2", "times.x5", "times.x10", "times.div2", "times.div5", "times.div10"],
      "lesson": [
        {
          "title": "Turn it round",
          "body": "3 × 5 and 5 × 3 are the same fact: 3 groups of 5 and 5 groups of 3 are both 15. Learn one way and you know both."
        },
        {
          "title": "Worked example",
          "example": {"template": "times.x5", "params": {"x": 5, "y": 7}, "format": "xy"}
        },
        {
          "title": "Times and divide go together",
          "body": "If 5 × 7 = 35, then 35 ÷ 5 = 7 and 35 ÷ 7 = 5. Every times fact gives you two divide facts."
        }
      ]
    },
    {
      "id": "3-and-4",
      "title": "3 and 4",
      "kind": "facts",
      "templates": ["times.x3", "times.x4", "times.div3", "times.div4"],
      "lesson": [
        {
          "title": "Build on doubles",
          "body": "Times 3 is double and one more group: 3 × 7 is 14 + 7 = 21. Times 4 is double, then double again: 7, 14, 28."
        },
        {
          "title": "Worked example",
          "example": {"template": "times.x4", "params": {"x": 4, "y": 7}, "format": "xy"}
        },
        {
          "title": "Quick is the goal",
          "body": "A fact is mastered when you get it right in under 4 seconds on two different days. Use the strategy until the answer just comes."
        }
      ]
    },
    {
      "id": "6-and-9",
      "title": "6 and 9",
      "kind": "facts",
      "templates": ["times.x6", "times.x9", "times.div6", "times.div9"],
      "lesson": [
        {
          "title": "Build from 5 and 10",
          "body": "6 × 8 is 5 × 8 and one more 8: 40 + 8 = 48. 9 × 8 is 10 × 8 take away one 8: 80 − 8 = 72."
        },
        {
          "title": "Worked example",
          "example": {"template": "times.x9", "params": {"x": 9, "y": 7}, "format": "xy"}
        },
        {
          "title": "A check for nines",
          "body": "Up to 9 × 10, the digits of a 9s answer add up to 9: 63 gives 6 + 3 = 9, and 72 gives 7 + 2 = 9."
        }
      ]
    },
    {
      "id": "7-and-8",
      "title": "7 and 8",
      "kind": "facts",
      "templates": ["times.x7", "times.x8", "times.div7", "times.div8"],
      "lesson": [
        {
          "title": "Only three new facts",
          "body": "You already know 7 and 8 times the other numbers from the tables before. The new facts are 7 × 7 = 49, 7 × 8 = 56 and 8 × 8 = 64."
        },
        {
          "title": "Worked example",
          "example": {"template": "times.x7", "params": {"x": 7, "y": 8}, "format": "xy"}
        },
        {"title": "5, 6, 7, 8", "body": "56 = 7 × 8: the digits 5, 6, 7 and 8 run in order."}
      ]
    },
    {
      "id": "11-and-12",
      "title": "11 and 12",
      "kind": "facts",
      "templates": ["times.x11", "times.x12", "times.div11", "times.div12"],
      "lesson": [
        {
          "title": "Times 11",
          "body": "11 times a number is 10 times it, then the number once more: 11 × 7 = 70 + 7 = 77."
        },
        {
          "title": "Worked example",
          "example": {"template": "times.x12", "params": {"x": 12, "y": 7}, "format": "xy"}
        },
        {
          "title": "Times 12",
          "body": "12 times a number is 10 times it plus double it: 12 × 6 = 60 + 12 = 72."
        }
      ]
    },
    {"id": "all", "title": "All the tables", "kind": "review"}
  ],
  "templates": [
    {
      "id": "times.x2",
      "domain": "NA",
      "construct": "Recall a times fact with 2",
      "schema": "equal-groups",
      "grid": true,
      "params": {"x": {"choose": [2]}, "y": {"choose": [2, 3, 4, 5, 6, 7, 8, 9, 10]}},
      "answer": {"type": "integer", "value": "x * y"},
      "formats": [{"id": "xy", "prompt": "{x} × {y} = ?"}, {"id": "yx", "prompt": "{y} × {x} = ?"}],
      "hints": ["Times 2 is the same as doubling.", "Double {y} is {y} + {y}.", "{y} + {y} = ?"],
      "steps": ["Times 2 means double", "Double {y} = {y} + {y}", "{y} + {y} = {answer}"],
      "explain": "2 × {y} is double {y}: {answer}.",
      "distractors": [
        {
          "value": "x * (y - 1)",
          "error": "one-group-short",
          "feedback": "{value} is {x} × {y - 1}: one group of {x} short."
        },
        {
          "value": "x * (y + 1)",
          "error": "one-group-too-many",
          "feedback": "{value} is {x} × {y + 1}: one group of {x} too many."
        },
        {
          "value": "x + y",
          "error": "added-instead",
          "feedback": "{value} is {x} + {y}. Times means {y} groups of {x}."
        }
      ]
    },
