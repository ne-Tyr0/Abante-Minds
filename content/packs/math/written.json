          "error": "left-out-a-zero",
          "feedback": "{value} leaves out a 0. When {d} does not go into a digit, write 0 in the answer and carry on."
        },
        {
          "value": "n - d",
          "error": "took-away-instead",
          "feedback": "{value} is {n} − {d}. ÷ shares {n} into {d} equal parts."
        },
        {
          "value": "q - q % 10",
          "error": "stopped-early",
          "feedback": "{value} is only the first chunk. {rest} is left to divide by {d}."
        }
      ]
    },
