    {
      "id": "written.column-take",
      "domain": "NA",
      "construct": "Take away three-digit numbers in columns, borrowing",
      "schema": "change",
      "params": {
        "a": {"tiers": {"1": [300, 999], "3": [300, 999]}},
        "b": {"tiers": {"1": [100, 299], "3": [100, "a - 1"]}},
        "a1": {"value": "a % 10"},
        "a2": {"value": "floor(a / 10) % 10"},
        "a3": {"value": "floor(a / 100)"},
        "b1": {"value": "b % 10"},
        "b2": {"value": "floor(b / 10) % 10"},
        "b3": {"value": "floor(b / 100)"},
        "br1": {"value": "a1 < b1 ? 1 : 0"},
        "r1": {"value": "a1 + 10 * br1 - b1"},
        "x2": {"value": "a2 - br1"},
        "br2": {"value": "x2 < b2 ? 1 : 0"},
        "r2": {"value": "x2 + 10 * br2 - b2"},
        "r3": {"value": "a3 - br2 - b3"}
      },
      "where": ["a > b", "a % 10 < b % 10 || floor(a / 10) % 10 < floor(b / 10) % 10", "floor(a / 10) % 10 != 0"],
      "answer": {"type": "integer", "value": "a - b"},
      "formats": [
        {"id": "difference", "prompt": "{a} − {b} = ?"},
        {
          "id": "left",
          "prompt": "A library has {a} books. {b} are borrowed. How many are left on the shelves?"
        }
      ],
      "hints": [
        "Line them up and take away the ones first. If the top digit is smaller, borrow from the next column.",
        "Ones: {a1 + 10 * br1} − {b1} = {r1}{br1 == 1 ? ', after borrowing a ten' : ''}.",
        "Tens: {x2 + 10 * br2} − {b2} = {r2}{br2 == 1 ? ', after borrowing a hundred' : ''}. Then the hundreds."
      ],
      "steps": [
        "Ones: {br1 == 1 ? 'borrow a ten, ' : ''}{a1 + 10 * br1} − {b1} = {r1}",
        "Tens: {br2 == 1 ? 'borrow a hundred, ' : ''}{x2 + 10 * br2} − {b2} = {r2}",
        "Hundreds: {a3 - br2} − {b3} = {r3}, so the answer is {answer}"
      ],
      "explain": "Column by column, borrowing where the top digit is smaller: {a} − {b} = {answer}.",
      "distractors": [
        {
          "value": "br1 + br2 > 0 ? 100 * (a3 - b3) + 10 * abs(a2 - b2) + abs(a1 - b1) : -1",
          "error": "took-smaller-from-bigger",
          "feedback": "{value} takes the smaller digit from the bigger in each column. When the top digit is smaller, borrow from the next column."
        },
        {
          "value": "br1 + br2 > 0 ? a - b + 10 * br1 + 100 * br2 : -1",
          "error": "did-not-pay-back",
          "feedback": "{value} borrows but does not take the 1 away from the column it borrowed from."
        },
        {"value": "a + b", "error": "added-instead", "feedback": "{value} is {a} + {b}. − means take away."}
      ]
    },
