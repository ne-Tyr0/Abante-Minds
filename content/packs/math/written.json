{
  "topic": "written",
  "levels": [
    {
      "id": "column-add",
      "title": "Column adding",
      "templates": ["written.column-add", "written.add-three"],
      "lesson": [
        {
          "title": "Line up the places",
          "body": "Write the numbers one under the other: ones under ones, tens under tens, hundreds under hundreds. Add the ones first."
        },
        {
          "title": "Worked example",
          "example": {"template": "written.column-add", "params": {"a": 457, "b": 268}, "format": "sum"}
        },
        {
          "title": "Carry the ten",
          "body": "When a column adds to 10 or more, write its ones digit and carry the ten to the next column, as a small 1 above it."
        }
      ]
    },
    {
      "id": "column-take",
      "title": "Column taking away",
      "templates": ["written.column-take", "written.take-across-zero"],
      "lesson": [
        {
          "title": "Borrow when the top is smaller",
          "body": "In 52 − 27, 2 is less than 7, so borrow a ten: 12 − 7 = 5, and the 5 tens become 4. 4 − 2 = 2. The answer is 25."
        },
        {
          "title": "Worked example",
          "example": {"template": "written.column-take", "params": {"a": 523, "b": 278}, "format": "difference"}
        },
        {
          "title": "Borrowing across a zero",
          "body": "503 has no tens to borrow, so borrow from the hundreds: 503 is 4 hundreds, 9 tens and 13 ones."
        }
      ]
    },
    {
      "id": "long-times",
      "title": "Long multiplication",
      "templates": ["written.times-one-digit", "written.times-two-digit"],
      "lesson": [
        {
          "title": "Multiply each digit",
          "body": "324 × 6: 4 × 6 = 24, write 4 carry 2; 2 × 6 + 2 = 14, write 4 carry 1; 3 × 6 + 1 = 19. The answer is 1944."
        },
        {
          "title": "Worked example",
          "example": {"template": "written.times-two-digit", "params": {"a": 34, "b": 26}, "format": "product"}
        },
        {
          "title": "Do not drop the zero",
          "body": "Multiplying by the tens digit means multiplying by tens: in 34 × 26, the tens row is 34 × 20 = 680, not 68."
        }
      ]
    },
    {
      "id": "long-divide",
      "title": "Long division",
      "templates": ["written.divide-one-digit", "written.remainder", "written.divide-two-digit"],
      "lesson": [
        {
          "title": "Take away chunks",
          "body": "744 ÷ 6: take away 6 × 100 = 600, leaving 144; take away 6 × 20 = 120, leaving 24; 24 ÷ 6 = 4. The answer is 100 + 20 + 4 = 124."
        },
        {
          "title": "Worked example",
          "example": {"template": "written.divide-one-digit", "params": {"d": 4, "q": 206}, "format": "quotient"}
        },
        {
          "title": "Remainders",
          "body": "157 ÷ 6: 6 × 26 = 156, and 1 is left over. The remainder is 1, which is always less than 6."
        }
      ]
    }
  ],
  "templates": [
    {
      "id": "written.column-add",
      "domain": "NA",
      "construct": "Add two three-digit numbers in columns, carrying",
      "schema": "combine",
      "params": {
        "a": {"tiers": {"1": [100, 499], "3": [100, 999]}},
        "b": {"tiers": {"1": [100, 499], "3": [100, 999]}},
        "a1": {"value": "a % 10"},
        "a2": {"value": "floor(a / 10) % 10"},
        "a3": {"value": "floor(a / 100)"},
        "b1": {"value": "b % 10"},
        "b2": {"value": "floor(b / 10) % 10"},
        "b3": {"value": "floor(b / 100)"},
        "c1": {"value": "floor((a1 + b1) / 10)"},
        "t": {"value": "a2 + b2 + c1"},
        "c2": {"value": "floor(t / 10)"},
        "h": {"value": "a3 + b3 + c2"}
      },
      "where": ["a % 10 + b % 10 >= 10 || floor(a / 10) % 10 + floor(b / 10) % 10 >= 10"],
      "answer": {"type": "integer", "value": "a + b"},
      "formats": [
        {"id": "sum", "prompt": "{a} + {b} = ?"},
        {"id": "votes", "prompt": "In a school vote, {a} pupils chose Ana and {b} chose Ben. How many voted?"}
      ],
      "hints": [
        "Line the numbers up by place value and add the ones first.",
        "Ones: {a1} + {b1} = {a1 + b1}{c1 > 0 ? '. Write ' : '.'}{c1 > 0 ? fmt((a1 + b1) % 10) : ''}{c1 > 0 ? ' and carry 1 to the tens.' : ''}",
        "Tens: {a2} + {b2}{c1 > 0 ? ' + 1' : ''} = {t}. Then the hundreds."
      ],
      "steps": [
        "Ones: {a1} + {b1} = {a1 + b1}{c1 > 0 ? ', write ' : ''}{c1 > 0 ? fmt((a1 + b1) % 10) : ''}{c1 > 0 ? ', carry 1' : ''}",
        "Tens: {a2} + {b2}{c1 > 0 ? ' + 1' : ''} = {t}{c2 > 0 ? ', write ' : ''}{c2 > 0 ? fmt(t % 10) : ''}{c2 > 0 ? ', carry 1' : ''}",
        "Hundreds: {a3} + {b3}{c2 > 0 ? ' + 1' : ''} = {h}, so the sum is {answer}"
      ],
      "explain": "Column by column, carrying where a column makes 10 or more: {a} + {b} = {answer}.",
      "distractors": [
        {
          "value": "c1 + c2 > 0 ? (a1 + b1) % 10 + 10 * ((a2 + b2) % 10) + 100 * (a3 + b3) : -1",
          "error": "forgot-to-carry",
          "feedback": "{value} forgets to carry. When a column adds to 10 or more, write the ones and carry 1 to the next column."
        },
        {
          "value": "a > b ? a - b : -1",
          "error": "took-away-instead",
          "feedback": "{value} is {a} − {b}. + means add."
        }
      ]
    },
