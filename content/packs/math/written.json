    {
      "id": "written.divide-one-digit",
      "domain": "NA",
      "construct": "Divide by a one-digit number by taking away chunks",
      "schema": "equal-groups",
      "params": {
        "d": {"tiers": {"1": [2, 5], "3": [3, 9]}},
        "q": {"tiers": {"1": [21, 199], "3": [101, 999]}},
        "n": {"value": "d * q"},
        "big": {"value": "q - q % 10"},
        "rest": {"value": "d * (q % 10)"}
      },
      "where": ["q % 10 != 0"],
      "answer": {"type": "integer", "value": "q"},
      "formats": [
        {"id": "quotient", "prompt": "{n} ÷ {d} = ?"},
        {
          "id": "share",
          "prompt": "{n} kg of rice is packed equally into {d} sacks. How many kilograms go in each sack?"
        }
      ],
      "hints": [
        "Take away a big chunk of {d}s first.",
        "{d} × {big} = {d * big}, which leaves {rest}.",
        "{rest} ÷ {d} = {q % 10}. Add the parts."
      ],
      "steps": [
        "Take away {d} × {big} = {d * big}: {n} − {d * big} = {rest}",
        "{rest} ÷ {d} = {q % 10}",
        "{big} + {q % 10} = {answer}"
      ],
      "explain": "{n} = {d} × {big} + {rest}, so {n} ÷ {d} = {big} + {q % 10} = {answer}.",
      "distractors": [
        {
