{
  "topic": "gemdas",
  "levels": [
    {
      "id": "gmdas",
      "title": "Order of operations",
      "templates": ["gemdas.add-times", "gemdas.take-divide", "gemdas.brackets", "gemdas.four-ops", "gemdas.shopping"],
      "lesson": [
        {
          "title": "GMDAS",
          "body": "Work out Grouping (brackets) first, then Multiplication and Division from left to right, then Addition and Subtraction from left to right."
        },
        {
          "title": "Worked example",
          "example": {"template": "gemdas.add-times", "params": {"a": 5, "b": 3, "c": 4}, "format": "expression"}
        },
        {
          "title": "Left to right",
          "body": "When two operations are of the same kind, go from left to right: 20 − 5 + 3 is 15 + 3 = 18, not 20 − 8 = 12."
        }
      ]
    },
    {
      "id": "decimals-fractions",
      "title": "With decimals and fractions",
      "templates": ["gemdas.decimal-ops", "gemdas.decimal-brackets", "gemdas.fraction-ops"],
      "lesson": [
        {
          "title": "The same order",
          "body": "Decimals and fractions follow the same order: brackets, then × and ÷, then + and −. 2.5 + 1.5 × 4 = 2.5 + 6 = 8.5."
        },
        {
          "title": "Worked example",
          "example": {
            "template": "gemdas.decimal-brackets",
            "params": {"ai": 6, "bi": 32, "ci": 12},
            "format": "expression"
          }
        }
      ]
    },
    {
      "id": "exponents",
      "title": "Exponents",
      "templates": ["gemdas.power-value", "gemdas.to-power", "gemdas.from-power"],
      "lesson": [
        {
          "title": "What an exponent means",
          "body": "2⁵ means five 2s multiplied: 2 × 2 × 2 × 2 × 2 = 32. The small raised number is the exponent; the 2 is the base."
        },
        {
          "title": "Worked example",
          "example": {"template": "gemdas.power-value", "params": {"b": 3, "e": 4}, "format": "value"}
        },
        {"title": "Not times", "body": "3⁴ is not 3 × 4 = 12. It is 3 × 3 × 3 × 3 = 81."}
      ]
    },
    {
      "id": "gemdas",
      "title": "Exponents first",
      "templates": ["gemdas.power-ops", "gemdas.power-brackets", "gemdas.power-take"],
      "lesson": [
        {
          "title": "GEMDAS",
          "body": "Exponents come straight after grouping: Grouping, Exponents, then × and ÷, then + and −."
        },
        {
          "title": "Worked example",
          "example": {"template": "gemdas.power-ops", "params": {"a": 2, "b": 3, "c": 2}, "format": "expression"}
        },
        {
          "title": "Brackets change it",
          "body": "2 + 3² = 2 + 9 = 11, but (2 + 3)² = 5² = 25: the brackets come before the exponent."
        }
      ]
    }
  ],
  "templates": [
    {
      "id": "gemdas.add-times",
      "competency": "G5.Q1.6",
      "domain": "NA",
      "construct": "Multiply before adding",
      "schema": "combine",
      "params": {
        "a": {"tiers": {"1": [2, 20], "3": [10, 99]}},
        "b": {"tiers": {"1": [2, 9], "3": [3, 12]}},
        "c": {"tiers": {"1": [2, 9], "3": [3, 12]}}
      },
      "answer": {"type": "integer", "value": "a + b * c"},
      "formats": [{"id": "expression", "prompt": "{a} + {b} × {c} = ?"}],
      "hints": ["Multiply before you add.", "{b} × {c} = {b * c}.", "{a} + {b * c} = ?"],
      "steps": ["Multiply first: {b} × {c} = {b * c}", "Then add: {a} + {b * c}", "= {answer}"],
      "explain": "× comes before +: {a} + {b * c} = {answer}.",
      "distractors": [
        {
          "value": "(a + b) * c",
          "error": "worked-left-to-right",
          "feedback": "{value} adds first. Multiply before you add: {b} × {c} = {b * c}, then add {a}."
        },
        {
          "value": "a + b + c",
          "error": "added-everything",
          "feedback": "{value} adds all three. {b} × {c} means {b} times {c}."
        }
      ]
    },
    {
      "id": "gemdas.take-divide",
      "competency": "G5.Q1.6",
      "domain": "NA",
      "construct": "Divide before taking away",
      "schema": "change",
      "params": {
        "q": {"tiers": {"1": [2, 9], "3": [3, 15]}},
        "d": {"tiers": {"1": [2, 9], "3": [3, 12]}},
        "n": {"value": "q * d"},
        "a": {"range": ["n + 1", "n + 30"]}
      },
      "where": ["a > q"],
      "answer": {"type": "integer", "value": "a - q"},
      "formats": [{"id": "expression", "prompt": "{a} − {n} ÷ {d} = ?"}],
      "hints": ["Divide before you take away.", "{n} ÷ {d} = {q}.", "{a} − {q} = ?"],
      "steps": ["Divide first: {n} ÷ {d} = {q}", "Then take away: {a} − {q}", "= {answer}"],
      "explain": "÷ comes before −: {a} − {q} = {answer}.",
      "distractors": [
        {
          "value": "a > n && (a - n) % d == 0 ? (a - n) / d : -1",
          "error": "worked-left-to-right",
          "feedback": "{value} takes away first. Divide before you take away: {n} ÷ {d} = {q}, then {a} − {q}."
        },
        {
          "value": "a > n ? a - n : -1",
          "error": "ignored-the-division",
          "feedback": "{value} takes all of {n} away. Divide first: {n} ÷ {d} = {q}, then take {q} away."
        }
      ]
    },
    {
      "id": "gemdas.brackets",
      "competency": "G5.Q1.6",
      "domain": "NA",
      "construct": "Work out brackets first",
      "schema": "combine",
      "params": {
        "a": {"tiers": {"1": [2, 12], "3": [5, 30]}},
        "b": {"tiers": {"1": [2, 12], "3": [5, 30]}},
        "c": {"tiers": {"1": [2, 9], "3": [3, 12]}}
      },
      "answer": {"type": "integer", "value": "(a + b) * c"},
      "formats": [
        {"id": "expression", "prompt": "({a} + {b}) × {c} = ?"},
        {"id": "turned", "prompt": "{c} × ({a} + {b}) = ?"}
      ],
      "hints": ["Work out the brackets first.", "{a} + {b} = {a + b}.", "{a + b} × {c} = ?"],
      "steps": ["Brackets first: {a} + {b} = {a + b}", "Then multiply: {a + b} × {c}", "= {answer}"],
      "explain": "Brackets first: {a + b} × {c} = {answer}.",
      "distractors": [
        {
          "value": "a + b * c",
          "error": "ignored-the-brackets",
          "feedback": "{value} multiplies first. The brackets come first: {a} + {b} = {a + b}, then × {c}."
        },
        {
          "value": "a * c + b",
          "error": "multiplied-only-one",
          "feedback": "{value} multiplies only {a} by {c}. The whole of ({a} + {b}) is multiplied."
        }
      ]
    },
    {
      "id": "gemdas.four-ops",
      "competency": "G5.Q1.6",
      "domain": "NA",
      "construct": "Three or more operations: multiply and divide, then add and take away from the left",
      "schema": "multi-step",
      "params": {
        "a": {"tiers": {"1": [2, 9], "3": [3, 12]}},
        "b": {"tiers": {"1": [2, 9], "3": [3, 12]}},
        "q": {"tiers": {"1": [2, 6], "3": [2, 9]}},
        "d": {"tiers": {"1": [2, 5], "3": [2, 9]}},
        "c": {"value": "q * d"},
        "e": {"tiers": {"1": [1, 9], "3": [2, 20]}}
      },
      "where": ["a * b > q + e"],
      "answer": {"type": "integer", "value": "a * b - q + e"},
      "formats": [{"id": "expression", "prompt": "{a} × {b} − {c} ÷ {d} + {e} = ?"}],
      "hints": [
        "Multiply and divide first, then add and take away from left to right.",
        "{a} × {b} = {a * b} and {c} ÷ {d} = {q}.",
        "{a * b} − {q} + {e} = ?"
      ],
      "steps": [
        "× and ÷ first: {a} × {b} = {a * b}, {c} ÷ {d} = {q}",
        "Left to right: {a * b} − {q} = {a * b - q}",
        "{a * b - q} + {e} = {answer}"
      ],
      "explain": "{a * b} − {q} + {e} = {answer}: × and ÷ first, then − and + from the left.",
      "distractors": [
        {
          "value": "a * b - (q + e)",
          "error": "added-before-taking-away",
          "feedback": "{value} adds {q} + {e} first. Adding and taking away go from left to right: {a * b} − {q}, then + {e}."
        },
        {
          "value": "(a * b - c) % d == 0 && a * b > c ? (a * b - c) / d + e : -1",
          "error": "worked-left-to-right",
          "feedback": "{value} takes away before dividing. Divide first: {c} ÷ {d} = {q}."
        }
      ]
    },
